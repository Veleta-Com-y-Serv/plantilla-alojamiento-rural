---
// Habitaciones: fichas grandes en filas alternas foto / texto (zigzag).
// `habitaciones` [{nombre, texto, precio, personas, extras, imagen}]: `precio` y `personas` como cadena
// («desde 95 €/noche», «2 personas»); `extras` es una cadena separada por comas. Lo que esté vacío no se pinta.
import { seccion, valores } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      {s.habitaciones.length > 0 && (
        <div class="zigzag">
          {s.habitaciones.map((h, i) => (
            <article class:list={['zigzag-fila', { 'zigzag-fila--invertida': i % 2 === 1, 'zigzag-fila--sola': !h.imagen }]}>
              {h.imagen && (
                <div class="zigzag-foto">
                  <Imagen src={h.imagen} alt={h.nombre} ancho={1200} alto={800} class="foto aspect-[3/2] w-full object-cover" />
                </div>
              )}
              <div class="zigzag-texto">
                <p class="zigzag-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="zigzag-titulo">{h.nombre}</h3>
                {(h.precio || h.personas) && (
                  <p class="ficha-datos">
                    {h.precio && <span class="ficha-precio">{h.precio}</span>}
                    {h.personas && (
                      <span class="inline-flex items-center gap-2">
                        <Icono nombre="usuarios" tam={18} />
                        {h.personas}
                      </span>
                    )}
                  </p>
                )}
                {h.texto && <p class="mt-4 leading-relaxed opacity-90">{h.texto}</p>}
                {valores(h.extras).length > 0 && (
                  <ul class="extras">
                    {valores(h.extras).map((x) => (
                      <li>
                        <Icono nombre="check" tam={16} class="shrink-0 text-acento" />
                        {x}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
      {s.cta?.url && (
        <p class="mt-14 text-center">
          <a class="btn" href={s.cta.url}>{s.cta.texto}</a>
        </p>
      )}
    </Seccion>
  )
}
