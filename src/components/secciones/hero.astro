---
// Portada editorial a toda altura: título en serif cursiva centrado con una línea fina debajo, texto y botones;
// debajo, la foto ancha con esquinas rectas y sombra suave. `items`: detalles cortos (con icono) bajo la foto.
// Sin `cta`, el botón principal llama por teléfono.
import { seccion, site, tel, externo } from '../../data/site';
import { altHero } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string; primera?: boolean }
const { id, primera = false } = Astro.props;
const s = seccion(id);
const c = site.contacto;
const principal = s?.cta?.url ? s.cta : c.telefono ? { texto: c.telefono, url: tel(c.telefono) } : null;
const secundario = s?.cta_secundario?.url ? s.cta_secundario : null;
const nueva = (u: string) => (externo(u) ? { rel: 'noopener', target: '_blank' } : {});
---

{
  s && (
    <section id={id} class="portada">
      <div class="contenedor portada-texto">
        {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
        <h1 class="portada-titulo">{s.titulo || site.nombre}</h1>
        <span class="portada-linea" aria-hidden="true" />
        {s.texto && <p class="portada-entradilla">{s.texto}</p>}
        {(principal || secundario) && (
          <div class="portada-botones">
            {principal && <a class="btn" href={principal.url} {...nueva(principal.url)}>{principal.texto}</a>}
            {secundario && <a class="btn-sec" href={secundario.url} {...nueva(secundario.url)}>{secundario.texto}</a>}
          </div>
        )}
      </div>
      {s.imagen && (
        <div class="contenedor contenedor--ancho portada-foto">
          <Imagen src={s.imagen} alt={altHero()} ancho={1920} alto={1080} prioridad={primera} class="foto h-full w-full object-cover" />
        </div>
      )}
      {s.items.length > 0 && (
        <ul class="contenedor portada-datos">
          {s.items.map((it) => (
            <li>
              {it.icono && <Icono nombre={it.icono} tam={20} class="text-acento" />}
              <span>{it.titulo}</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}
